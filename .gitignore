# 运行产物与临时文件不入库
runs/
# reports/ 下全是生成物。注意两点：
#   ① `reports/*.md` 只匹配根层，子目录会漏，故用 `reports/*`；
#   ② 目录本身不能整体排除，否则无法用 ! 反选回 README.md。
reports/*
!reports/README.md
*.log
*.json
!configs/pipelines.json

# EQY 运行残留（正常情况会被 formal/mini/run_formal_mini.sh 归档到 runs/）
equiv_*/
equiv_ok/
equiv_bad/

# 一次性诊断输出
_*.txt

# 编辑器/系统
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc

# EQY 工作目录：eqy 在 CWD 生成 <top>/ 与 <top>_eqy/，属运行产物，禁止入库
/test[0-9]/
/test[0-9][0-9]/
/*_eqy/
/equivalent_*/

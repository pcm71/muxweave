  connect \_11_ [1:0] { \sr_reg[1] \sr_reg[2] }
  connect \sr { \rw \sr_reg[6] \sr_reg[5] \sr_reg[4] \sr_reg[3] \sr_reg[2] \sr_reg[1] \sr_reg[0] }
end

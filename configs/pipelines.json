    "ABC_nf": {
      "desc": "ABC 脚本变体：映射前插入 &nf（节点因式分解）",
      "id": "ABC_nf",
      "pre": [], "opt": [], "post": [],
      "backend_passes": [
        "synth_intel -family cycloneiv -top @@TOP@@ -run begin:map_luts",

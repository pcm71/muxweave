    "_abc_script_file_doc": "以下用**真正的 ABC 脚本文件**（configs/abc_scripts/*.abc）替换默认脚本。这是主办方点名要求提交的『调优 abc 脚本』形态。注意：内联写法 -script \"+a;b;c\" 会被 Yosys 脚本解析器按分号拆开，所以必须用文件。已实测：用 -script 时 Yosys 仍会照常发送 read_lut <lutdefs.txt>。",

    "SCRIPT_baseline": {
      "desc": "自洽性检查：把 abc 默认 -lut 脚本原文写成文件跑一遍，结果必须与 ABC_classic 的 263 完全一致",
      "id": "SCRIPT_baseline",
      "pre": [], "opt": [], "post": [],
      "backend_passes": [
        "synth_intel -family cycloneiv -top @@TOP@@ -run begin:map_luts",
        "abc -lut 4 -script @@REPO@@/configs/abc_scripts/baseline_lut4.abc",
        "clean", "opt -fast", "autoname", "clean",

{
  "_doc": "基线、加强基线与 pmux_opt 插入点候选 pipeline。由 scripts/run_case.py 读取并生成实际 ys 脚本；生成结果会写入 runs/<run_id>/synth.ys 作为证据。",
  "_placeholders": ["@@TOP@@", "@@STAT_JSON@@", "@@OPT_JSON@@", "@@ANALYZE_JSON@@"],

  "backend": {
    "name": "synth_intel_cycloneiv",
    "passes": ["synth_intel -family cycloneiv"],
    "stat": "tee -o @@STAT_JSON@@ stat -json",
    "_verify": "已实测(Yosys 0.69)：`stat -json <文件>` 不写文件，参数会被当成模块选择模式，JSON 只打到 stdout；写文件必须用 `tee -o <文件> stat -json`。family 取值 cycloneiv 已验证可用（映射为 cycloneiv_lcell_comb）。JSON 字段名为 num_cells / num_cells_by_type，并含 design 全设计聚合项。"
  },

  "pipelines": {
    "B0": {
      "desc": "官方统一流程基线：proc 后直接进入 synth_intel，不做额外优化。",
      "id": "B0",
      "pre": ["proc"],
      "opt": [],
      "post": []
    },
    "B1": {
      "desc": "加强基线：在 synth_intel 之前叠加已有细粒度优化，用于检验自研收益是否只是别人已实现的能力。",
      "id": "B1",
      "pre": ["proc", "opt"],
      "opt": [],
      "post": ["opt_reduce -fine", "opt_merge", "opt_muxtree", "opt_share"]
    },
    "O_INSERT_A": {
      "desc": "作品路线 A：pmux_opt 紧随 proc（此时 $pmux 尚未被破坏，但周边逻辑未清理）。",
      "id": "O_INSERT_A",
      "pre": ["proc"],
      "opt": ["pmux_opt -json @@OPT_JSON@@"],
      "post": ["opt_clean"]
    },
    "O_INSERT_B": {
      "desc": "作品路线 B：先 opt 再 pmux_opt（控制/数据重复更容易暴露，但 mux 树可能已被部分化简）。",
      "id": "O_INSERT_B",
      "pre": ["proc", "opt"],
      "opt": ["pmux_opt -json @@OPT_JSON@@"],
      "post": ["opt"]
    },
    "ANALYZE_ONLY": {
      "desc": "只分析不改网表：用于第 1 周的 PMUX 识别核对与人机会话。",
      "id": "ANALYZE_ONLY",
      "pre": ["proc"],
      "opt": ["pmux_analyze -json @@ANALYZE_JSON@@"],
      "post": []
    },

    "_battery_doc": "以下 P_* 是第 2 周的『已有能力电池』：逐个测试 Yosys 自带的、与 mux/共享/化简相关的 pass，看它们插在 synth_intel 之前能否比 B0 省单元。用来定位『官方后端是否还有没吃掉的优化空间』。",

    "P_pmux2shiftx": {
      "desc": "电池：pmux2shiftx（把 PMUX 结构转成移位结构，Yosys 自带但不在 synth_intel 流程内）",
      "id": "P_pmux2shiftx",
      "pre": ["proc"],
      "opt": [],
      "post": ["pmux2shiftx"]
    },
    "P_muxpack": {
      "desc": "电池：muxpack（把 mux 树打包成更宽的单元）",
      "id": "P_muxpack",
      "pre": ["proc"],
      "opt": [],
      "post": ["muxpack"]
    },
    "P_share": {
      "desc": "电池：share（资源共享）",
      "id": "P_share",
      "pre": ["proc"],
      "opt": [],
      "post": ["share"]
    },
    "P_opt_reduce_fine": {
      "desc": "电池：opt_reduce -fine（细粒度 MUX 输入合并；验证是否真的被 opt -fine -full 覆盖）",
      "id": "P_opt_reduce_fine",
      "pre": ["proc"],
      "opt": [],
      "post": ["opt_reduce -fine"]
    },
    "P_muxtree": {
      "desc": "电池：opt_muxtree（删除不可能激活的分支）",
      "id": "P_muxtree",
      "pre": ["proc"],
      "opt": [],
      "post": ["opt_muxtree"]
    },
    "P_wreduce": {
      "desc": "电池：wreduce（位宽缩减）",
      "id": "P_wreduce",
      "pre": ["proc"],
      "opt": [],
      "post": ["wreduce"]
    },
    "P_pmx2s_muxpack": {
      "desc": "电池：pmux2shiftx + muxpack 组合",
      "id": "P_pmx2s_muxpack",
      "pre": ["proc"],
      "opt": [],
      "post": ["pmux2shiftx", "muxpack"]
    },

    "_abc_doc": "ABC 脚本杠杆实验：用 synth_intel 的 -run 分段标签（begin:/family:/coarse:/map_bram:/map_ffram:/map_ffs:/map_luts:/map_cells:/check:）把官方 abc9 那一步换掉。主办方明确允许『可以调整 abc 的脚本』，且本项目观测到的最大杠杆就是 ABC（0.68→0.69 的 9.5%→24.6% 完全来自 ABC 变化）。注意：这些 pipeline 自带 backend_passes，会覆盖默认 backend。",

    "ABC_baseline": {
      "desc": "ABC 组内部基准：分段调用 synth_intel 但 abc 步骤与官方完全相同（应等于 B0 的 284）",
      "id": "ABC_baseline",
      "pre": [],
      "opt": [],
      "post": [],
      "backend_passes": [
        "synth_intel -family cycloneiv -top @@TOP@@ -run begin:map_luts",
        "abc9 -lut 4 -W 300",
        "clean", "opt -fast", "autoname", "clean",
        "synth_intel -family cycloneiv -top @@TOP@@ -run map_cells:check"
      ]
    },
    "ABC_classic": {

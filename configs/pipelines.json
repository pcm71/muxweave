    "ABC_and": {
      "desc": "ABC 变体：强制只映射成 AND 门（-g AND），看 LUT 打包是否更好",
      "id": "ABC_and",
      "pre": [], "opt": [], "post": [],
      "backend_passes": [
        "synth_intel -family cycloneiv -top @@TOP@@ -run begin:map_luts",
